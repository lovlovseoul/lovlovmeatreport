  ]
};

for(const [gridId, terms] of Object.entries(glossary)){
  const grid = document.getElementById(gridId);
  terms.forEach(t=>{
    const div = document.createElement('div');
    div.className = 'term-card';
    div.dataset.search = (t.abbr+' '+t.kr+' '+t.full+' '+t.desc).toLowerCase();
    div.innerHTML = `
      <div class="term-head">
        <span class="term-abbr">${t.abbr}</span>
        <span class="term-kr">${t.kr}${t.full ? ' · '+t.full : ''}</span>
      </div>
      <div class="term-desc">${t.desc}</div>
      ${t.example ? `<div class="term-example"><b>예시</b> ${t.example}</div>` : ''}
    `;
    grid.appendChild(div);
  });
}

document.getElementById('glossarySearch').addEventListener('input', (e)=>{
  const q = e.target.value.toLowerCase().trim();
  document.querySelectorAll('.term-card').forEach(card=>{
    card.classList.toggle('hidden', q && !card.dataset.search.includes(q));
  });
  document.querySelectorAll('.glossary-group').forEach(group=>{
    const visible = group.querySelectorAll('.term-card:not(.hidden)').length;
    group.style.display = visible === 0 ? 'none' : '';
  });
});

document.getElementById('genTime').textContent = '페이지 생성: ' + new Date().toLocaleString('ko-KR');
</script>
