  glossaryPerf: [
    {abbr:"ROAS", kr:"광고 수익률", full:"Return on Ad Spend",
     desc:"광고비 대비 발생한 매출의 비율. 500%라면 광고비의 5배 매출을 냈다는 뜻이에요.",
