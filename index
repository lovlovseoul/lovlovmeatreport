// ---------- Creative grid ----------
const grid = document.getElementById('creativeGrid');
const avgCtr = creatives.reduce((a,c)=>a+c.ctr,0)/creatives.length;
creatives.forEach(c=>{
  const div = document.createElement('div');
  div.className = 'creative-card';
  const badge = c.ctr >= avgCtr ? '<span class="perf-badge good">CTR 평균 이상</span>' : (c.ctr < 4 ? '<span class="perf-badge bad">CTR 저조</span>' : '');
  const roasLine = c.roas != null
    ? `<div style="font-size:12px;color:var(--ink-soft);border-top:1px solid var(--line);padding-top:8px;display:flex;justify-content:space-between;"><span>광고비 <b style="color:var(--ink);">₩${c.spend.toLocaleString()}</b></span><span style="color:${c.roas>=2?'var(--green)':'var(--red)'};font-weight:700;">ROAS ${c.roas.toFixed(2)}x</span></div>`
    : `<div style="font-size:12px;color:var(--ink-soft);border-top:1px solid var(--line);padding-top:8px;">광고비 <b style="color:var(--ink);">₩${c.spend.toLocaleString()}</b></div>`;
  div.innerHTML = `
    <div class="thumb-wrap">
      <img src="${c.thumb}" alt="${c.name}" loading="lazy" onerror="this.parentElement.style.background='var(--brown-soft)';this.remove();">
      <span class="type-badge">${c.type}</span>
    </div>
    <div class="creative-body">
      <div class="creative-title">${c.name}</div>
      ${badge}
      <div class="creative-stats">
        <span>노출 <b>${c.imp.toLocaleString()}</b></span>
        <span>클릭 <b>${c.clk.toLocaleString()}</b></span>
        <span>CTR <b>${c.ctr.toFixed(2)}%</b></span>
        <span>CPM <b>₩${c.cpm.toLocaleString()}</b></span>
      </div>
      ${roasLine}
    </div>
  `;
  grid.appendChild(div);
});

