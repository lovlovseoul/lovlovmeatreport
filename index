function fillTable(id, rows, withCpm){
  const tbody = document.getElementById(id);
  rows.forEach(r=>{
    const tr = document.createElement('tr');
    if(withCpm){
      const [name,imp,clk,ctr,cpm,spend,roas] = r;
      const roasCell = roas != null ? `${roas.toFixed(2)}x` : '<span style="color:var(--ink-soft)">–</span>';
      tr.innerHTML = `<td>${name}</td><td class="num">${imp.toLocaleString()}</td><td class="num">${clk.toLocaleString()}</td><td class="num">${ctr.toFixed(2)}%</td><td class="num">₩${cpm.toLocaleString()}</td><td class="num">₩${spend.toLocaleString()}</td><td class="num">${roasCell}</td>`;
    }else{
      const [name,imp,clk,ctr,spend,roas] = r;
      const roasCell = roas != null ? `${roas.toFixed(2)}x` : '<span style="color:var(--ink-soft)">–</span>';
      tr.innerHTML = `<td>${name}</td><td class="num">${imp.toLocaleString()}</td><td class="num">${clk.toLocaleString()}</td><td class="num">${ctr.toFixed(2)}%</td><td class="num">₩${spend.toLocaleString()}</td><td class="num">${roasCell}</td>`;
    }
    tbody.appendChild(tr);
  });
}
